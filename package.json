{
  "name": "clawctrl-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.0.0"
  },
  "scripts": {
    "setup": "npm ci && npm ci --prefix frontend",
    "dev": "tauri dev",
    "build": "tauri build",
    "test": "npm --prefix frontend test --",
    "test:sessions": "cargo test --manifest-path src-tauri/Cargo.toml --lib session_persistence::tests && cargo test --manifest-path src-tauri/Cargo.toml --lib server::session_lifecycle_tests",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test": "npm --prefix frontend run test",
    "frontend:typecheck": "npm --prefix frontend run typecheck",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:dead-code": "node scripts/check-dead-code.mjs",
    "check:tauri": "cargo check --manifest-path src-tauri/Cargo.toml --bin clawctrl",
    "portainer:certify-live": "node scripts/portainer-live-certify.mjs",
    "portainer:test-certify-readonly": "node scripts/test-portainer-live-certify-readonly.mjs",
    "portainer:test-certify-disposable": "node scripts/test-portainer-live-certify-disposable.mjs",
    "proxmox:certify-live": "node scripts/proxmox-live-certify.mjs",
    "proxmox:test-certify-readonly": "node scripts/test-proxmox-live-certify-readonly.mjs",
    "proxmox:test-certify-write": "node scripts/test-proxmox-live-certify-write.mjs",
    "check": "npm run check:architecture && npm run frontend:typecheck && npm run check:dead-code",
    "check:all": "npm run check && npm run check:rust && npm run test:backend && npm test && npm run frontend:build && npm run check:bundle && npm run check:tauri",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml --locked --all-targets -- --test-threads=1",
    "check:rustfmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "check:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D clippy::correctness -D clippy::suspicious",
    "check:rust": "npm run check:rustfmt && npm run check:clippy",
    "review:install": "playwright install --with-deps chromium",
    "review:features": "playwright test",
    "review:report": "playwright show-report --host 127.0.0.1"
  }
}
