  "openapi": "3.1.0",
  "info": {
    "title": "Clawctrl local Notes API",
    "version": "1.1.0",
    "description": "Device-local Notes CRUD. Desktop access requires its API key and verified session. Revocable Notes-only device bearer credentials are issued by a verified desktop owner; they do not share the desktop session. Notes quick capture uses the same PUT. General quick-capture inbox behavior remains separate."
  },
