  "components": {
    "securitySchemes": {
      "desktopApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "notesDevice": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque per-device Notes-only credential. Created once by an MFA-verified desktop owner; revocable and expires after 90 days. Send only over HTTPS. Never send as a query parameter."
      }
    },
    "schemas": {
      "NoteId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "allOf": [
          {
            "not": {
              "pattern": "\\.\\."
            }
          },
          {
            "not": {
              "pattern": "^_"
            }
          },
          {
            "not": {
              "pattern": "\\u0000"
            }
          },
          {
            "pattern": "\\S"
          }
        ]
      },
      "NoteRevision": {
        "type": "string",
        "pattern": "^local-[0-9]+$",
        "description": "Opaque current revision; retain exactly for the next conditional write."
      },
      "Timestamp": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "Unix epoch milliseconds."
      },
      "OperationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "NoteDocument": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/NoteId"
          },
          "_rev": {
            "$ref": "#/components/schemas/NoteRevision"
          },
          "type": {
            "type": "string",
            "const": "note"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "folder": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "created_at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "updated_at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "trashed_at": {
            "type": [
              "integer",
              "null"
            ]
          },
          "trash_origin_path": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "_id",
          "_rev",
          "type",
          "title",
          "content",
          "folder",
          "tags",
          "links",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "_id": "Workspace/Review note.md",
            "_rev": "local-1768478400000",
            "type": "note",
            "title": "Review note",
            "folder": "Workspace",
            "content": "# Review note\n\nA fixed sample note for feature review.\n",
            "tags": [],
            "links": [],
            "aliases": [],
            "properties": {},
            "created_at": 1768478400000,
            "updated_at": 1768478400000
          }
        ]
      },
      "NoteWrite": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/NoteId"
          },
          "_rev": {
            "$ref": "#/components/schemas/NoteRevision"
          },
          "type": {
            "type": "string",
            "const": "note"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "folder": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "created_at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "updated_at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "trashed_at": {
            "type": [
              "integer",
              "null"
            ]
          },
          "trash_origin_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_json": {},
          "operation_id": {
            "$ref": "#/components/schemas/OperationId"
          }
        },
        "required": [
          "content"
        ],
        "additionalProperties": true
      },
      "NoteListData": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoteDocument"
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": [
          "notes",
          "attachments"
        ],
        "additionalProperties": false
      },
      "NoteWriteData": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/NoteId"
          },
          "rev": {
            "$ref": "#/components/schemas/NoteRevision"
          }
        },
        "required": [
          "id",
          "rev"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
